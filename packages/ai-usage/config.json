{
  "tokens": {
    "text": { "light": "#1f2329", "dark": "#e6e9ef" },
    "textMuted": { "light": "#5f6773", "dark": "#9aa3b0" },
    "surfaceRaised": { "light": "#ffffff", "dark": "#323438" },
    "track": { "light": "#1d1d1f26", "dark": "#f5f5f726" }
  },
  "widgets": [
    {
      "id": "ai-usage",
      "type": "script",
      "position": "right",
      "command": "\"$PACKAGE_DIR/scripts/usage.sh\"",
      "interval": "@setting.interval",
      "timeout": 30,
      "environment": {
        "PROVIDERS": "@setting.providers",
        "CLAUDE_LIMITS": "@setting.claudeLimits",
        "CODEX_LIMITS": "@setting.codexLimits",
        "SHOW": "@setting.show",
        "USAGE": "@setting.usage"
      },
      "layout": {
        "type": "row",
        "style": { "spacing": 10 },
        "children": [
          {
            "type": "row",
            "hideWhenEmpty": "claudePlan",
            "style": { "spacing": 4 },
            "children": [
              { "type": "symbol", "name": "asterisk" },
              {
                "type": "column",
                "hideWhenEmpty": "claudeTop",
                "style": { "spacing": 2 },
                "children": [
                  { "type": "progress", "source": "claudeTop", "height": 5, "style": { "width": 20, "accent": "@token.text", "background": "@token.track" } },
                  {
                    "type": "progress", "source": "claudeBottom", "height": 3, "hideWhenEmpty": "claudeBottom",
                    "style": { "width": 20, "accent": "@token.text", "background": "@token.track" }
                  }
                ]
              },
              { "type": "field", "field": "claudeText", "hideWhenEmpty": "claudeText" }
            ]
          },
          {
            "type": "row",
            "hideWhenEmpty": "codexPlan",
            "style": { "spacing": 4 },
            "children": [
              { "type": "symbol", "name": "terminal" },
              {
                "type": "column",
                "hideWhenEmpty": "codexTop",
                "style": { "spacing": 2 },
                "children": [
                  { "type": "progress", "source": "codexTop", "height": 5, "style": { "width": 20, "accent": "@token.text", "background": "@token.track" } },
                  {
                    "type": "progress", "source": "codexBottom", "height": 3, "hideWhenEmpty": "codexBottom",
                    "style": { "width": 20, "accent": "@token.text", "background": "@token.track" }
                  }
                ]
              },
              { "type": "field", "field": "codexText", "hideWhenEmpty": "codexText" }
            ]
          }
        ]
      },
      "popup": {
        "style": { "width": 300, "paddingHorizontal": 18, "paddingVertical": 16, "spacing": 12 },
        "layout": {
          "type": "column",
          "children": [
            {
              "type": "column",
              "hideWhenEmpty": "claudePlan",
              "children": [
                {
                  "type": "row",
                  "children": [
                    { "type": "text", "text": "Claude", "style": { "fontWeight": "bold", "fontSize": 15 } },
                    { "type": "field", "field": "claudePlan", "alignment": "trailing", "style": { "foreground": "@token.textMuted" } }
                  ]
                },
                {
                  "type": "list",
                  "source": "claude",
                  "style": { "spacing": 14 },
                  "row": {
                    "type": "column",
                    "style": { "spacing": 5 },
                    "children": [
                      { "type": "field", "field": "title", "style": { "fontWeight": "semibold" } },
                      { "type": "progress", "source": "fraction", "height": 6, "style": { "background": "@token.track" } },
                      {
                        "type": "row",
                        "children": [
                          { "type": "field", "field": "detail" },
                          { "type": "field", "field": "trailing", "alignment": "trailing", "style": { "foreground": "@token.textMuted" } }
                        ]
                      },
                      { "type": "field", "field": "pace", "hideWhenEmpty": "pace", "style": { "foreground": "@token.textMuted" } }
                    ]
                  }
                },
                {
                  "type": "text", "text": "Usage dashboard", "open": "https://claude.ai/settings/usage",
                  "style": { "paddingHorizontal": 6, "paddingVertical": 4, "cornerRadius": 6, "hoverBackground": "@token.surfaceRaised" }
                },
                { "type": "divider", "hideWhenEmpty": "codexPlan" }
              ]
            },
            {
              "type": "column",
              "hideWhenEmpty": "codexPlan",
              "children": [
                {
                  "type": "row",
                  "children": [
                    { "type": "text", "text": "Codex", "style": { "fontWeight": "bold", "fontSize": 15 } },
                    { "type": "field", "field": "codexPlan", "alignment": "trailing", "style": { "foreground": "@token.textMuted" } }
                  ]
                },
                {
                  "type": "list",
                  "source": "codex",
                  "style": { "spacing": 14 },
                  "row": {
                    "type": "column",
                    "style": { "spacing": 5 },
                    "children": [
                      { "type": "field", "field": "title", "style": { "fontWeight": "semibold" } },
                      { "type": "progress", "source": "fraction", "height": 6, "style": { "background": "@token.track" } },
                      {
                        "type": "row",
                        "children": [
                          { "type": "field", "field": "detail" },
                          { "type": "field", "field": "trailing", "alignment": "trailing", "style": { "foreground": "@token.textMuted" } }
                        ]
                      },
                      { "type": "field", "field": "pace", "hideWhenEmpty": "pace", "style": { "foreground": "@token.textMuted" } }
                    ]
                  }
                },
                {
                  "type": "text", "text": "Usage dashboard", "open": "https://chatgpt.com/codex/settings/usage",
                  "style": { "paddingHorizontal": 6, "paddingVertical": 4, "cornerRadius": 6, "hoverBackground": "@token.surfaceRaised" }
                }
              ]
            },
            { "type": "divider" },
            { "type": "field", "field": "updated", "style": { "foreground": "@token.textMuted" } }
          ]
        }
      }
    }
  ]
}
