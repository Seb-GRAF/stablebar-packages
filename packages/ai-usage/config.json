{
  "tokens": {
    "text": { "light": "#1f2329", "dark": "#e6e9ef" },
    "textMuted": { "light": "#5f6773", "dark": "#9aa3b0" },
    "surfaceRaised": { "light": "#ffffff", "dark": "#323438" },
    "track": { "light": "#1d1d1f26", "dark": "#f5f5f726" }
  },
  "widgets": [
    {
      "id": "ai-usage",
      "type": "script",
      "position": "right",
      "command": "\"$PACKAGE_DIR/scripts/usage.sh\"",
      "interval": 300,
      "timeout": 30,
      "environment": {
        "CLAUDE": "@setting.claude",
        "CLAUDE_ACCOUNTS": "@setting.claudeAccounts",
        "CODEX": "@setting.codex",
        "LAYOUT": "@setting.layout",
        "METERS": "@setting.meters",
        "PERCENTAGES": "@setting.percentages",
        "PERCENTAGES_SHOW": "@setting.percentagesShow",
        "RESET_TIMES": "@setting.resetTimes",
        "REFRESH": "@setting.updates"
      },
      "layout": {
        "type": "list",
        "source": "bar",
        "orientation": "horizontal",
        "style": { "spacing": 10 },
        "row": {
          "type": "row",
          "styleField": "look",
          "style": { "spacing": 5 },
          "children": [
            { "type": "symbol", "source": "symbol" },
            {
              "type": "row",
              "hideWhenEmpty": "stacked",
              "style": { "spacing": 0 },
              "children": [
                { "type": "field", "field": "name", "hideWhenEmpty": "name", "style": { "fontSize": 11, "fontWeight": "semibold", "foreground": "@token.textMuted", "paddingTrailing": 5 } },
                { "type": "text", "text": " ", "style": { "width": 0 } },
                {
                  "type": "row",
                  "style": { "spacing": 5, "height": 0 },
                  "children": [
                    {
                      "type": "column",
                      "hideWhenEmpty": "meters",
                      "style": { "spacing": 8 },
                      "children": [
                        {
                          "type": "progress", "source": "sessionMeter", "height": 3, "hideWhenEmpty": "sessionMeter",
                          "style": { "width": 20, "accent": "@token.text", "background": "@token.track" }
                        },
                        {
                          "type": "progress", "source": "weeklyMeter", "height": 3, "hideWhenEmpty": "weeklyMeter",
                          "style": { "width": 20, "accent": "@token.text", "background": "@token.track" }
                        }
                      ]
                    },
                    {
                      "type": "column",
                      "hideWhenEmpty": "percents",
                      "alignment": "leading",
                      "style": { "spacing": 0 },
                      "children": [
                        { "type": "field", "field": "sessionPercent", "hideWhenEmpty": "sessionPercent", "style": { "fontSize": 9.5, "fontWeight": "medium" } },
                        { "type": "field", "field": "weeklyPercent", "hideWhenEmpty": "weeklyPercent", "style": { "fontSize": 9.5, "fontWeight": "medium" } }
                      ]
                    },
                    {
                      "type": "column",
                      "hideWhenEmpty": "resets",
                      "alignment": "leading",
                      "style": { "spacing": 0 },
                      "children": [
                        { "type": "field", "field": "sessionReset", "hideWhenEmpty": "sessionReset", "style": { "fontSize": 9.5, "foreground": "@token.textMuted" } },
                        { "type": "field", "field": "weeklyReset", "hideWhenEmpty": "weeklyReset", "style": { "fontSize": 9.5, "foreground": "@token.textMuted" } }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "row",
              "hideWhenEmpty": "oneLine",
              "style": { "spacing": 9 },
              "children": [
                { "type": "field", "field": "name", "hideWhenEmpty": "name", "style": { "fontSize": 11, "fontWeight": "semibold", "foreground": "@token.textMuted" } },
                {
                  "type": "row",
                  "hideWhenEmpty": "sessionLabel",
                  "style": { "spacing": 4 },
                  "children": [
                    { "type": "field", "field": "sessionLabel", "style": { "fontSize": 11, "fontWeight": "semibold", "foreground": "@token.textMuted" } },
                    {
                      "type": "progress", "source": "sessionMeter", "height": 5, "hideWhenEmpty": "sessionMeter",
                      "style": { "width": 20, "accent": "@token.text", "background": "@token.track" }
                    },
                    { "type": "field", "field": "sessionPercent", "hideWhenEmpty": "sessionPercent" },
                    { "type": "field", "field": "sessionReset", "hideWhenEmpty": "sessionReset", "style": { "foreground": "@token.textMuted" } }
                  ]
                },
                {
                  "type": "row",
                  "hideWhenEmpty": "weeklyLabel",
                  "style": { "spacing": 4 },
                  "children": [
                    { "type": "field", "field": "weeklyLabel", "style": { "fontSize": 11, "fontWeight": "semibold", "foreground": "@token.textMuted" } },
                    {
                      "type": "progress", "source": "weeklyMeter", "height": 5, "hideWhenEmpty": "weeklyMeter",
                      "style": { "width": 20, "accent": "@token.text", "background": "@token.track" }
                    },
                    { "type": "field", "field": "weeklyPercent", "hideWhenEmpty": "weeklyPercent" },
                    { "type": "field", "field": "weeklyReset", "hideWhenEmpty": "weeklyReset", "style": { "foreground": "@token.textMuted" } }
                  ]
                }
              ]
            }
          ]
        }
      },
      "popup": {
        "style": { "width": 300, "paddingHorizontal": 18, "paddingVertical": 16, "spacing": 12 },
        "layout": {
          "type": "column",
          "children": [
            {
              "type": "list",
              "source": "popup",
              "style": { "spacing": 12 },
              "row": {
                "type": "column",
                "style": { "spacing": 5 },
                "children": [
                  { "type": "divider", "hideWhenEmpty": "divider" },
                  {
                    "type": "row",
                    "hideWhenEmpty": "header",
                    "children": [
                      { "type": "field", "field": "header", "style": { "fontWeight": "bold", "fontSize": 15 } },
                      { "type": "field", "field": "plan", "alignment": "trailing", "style": { "foreground": "@token.textMuted" } }
                    ]
                  },
                  {
                    "type": "row",
                    "hideWhenEmpty": "note",
                    "style": { "spacing": 6 },
                    "children": [
                      { "type": "symbol", "name": "exclamationmark.triangle", "style": { "width": 18, "foreground": "@token.textMuted" } },
                      { "type": "field", "field": "note", "wrap": true, "alignment": "leading", "style": { "foreground": "@token.textMuted" } }
                    ]
                  },
                  {
                    "type": "column",
                    "hideWhenEmpty": "title",
                    "style": { "spacing": 5 },
                    "children": [
                      { "type": "field", "field": "title", "style": { "fontWeight": "semibold" } },
                      { "type": "progress", "source": "fraction", "height": 6, "style": { "background": "@token.track" } },
                      {
                        "type": "row",
                        "children": [
                          { "type": "field", "field": "detail" },
                          { "type": "field", "field": "trailing", "alignment": "trailing", "style": { "foreground": "@token.textMuted" } }
                        ]
                      },
                      { "type": "field", "field": "pace", "hideWhenEmpty": "pace", "style": { "foreground": "@token.textMuted" } }
                    ]
                  },
                  {
                    "type": "text", "text": "Usage dashboard", "openField": "dashboard", "hideWhenEmpty": "dashboard",
                    "style": { "paddingHorizontal": 6, "paddingVertical": 4, "cornerRadius": 6, "hoverBackground": "@token.surfaceRaised" }
                  }
                ]
              }
            },
            { "type": "divider" },
            { "type": "field", "field": "updated", "style": { "foreground": "@token.textMuted" } }
          ]
        }
      }
    }
  ]
}
