{
  "id": "ai-usage",
  "name": "AI usage",
  "version": "1.2.3",
  "description": "Shows your Claude Code and Codex limits in one widget, with reset countdowns and weekly pace, using the sign-ins those tools already keep.",
  "author": "StableBar",
  "repository": "https://github.com/Seb-GRAF/stablebar-packages",
  "entry": "config.json",
  "screenshot": "preview.png",
  "hosts": ["api.anthropic.com", "chatgpt.com"],
  "settings": {
    "providers": { "type": "string", "title": "Providers", "default": "both", "choices": ["claude", "codex", "both"] },
    "claudeLimits": { "type": "string", "title": "Claude limits in the bar", "default": "both", "choices": ["session", "weekly", "both"] },
    "codexLimits": { "type": "string", "title": "Codex limits in the bar", "default": "both", "choices": ["session", "weekly", "both"] },
    "show": { "type": "string", "title": "Bar shows", "default": "both", "choices": ["meters", "percent", "both"] },
    "usage": { "type": "string", "title": "Show usage as", "default": "left", "choices": ["left", "used"] },
    "interval": { "type": "number", "title": "Refresh every (seconds)", "default": 300 }
  }
}
