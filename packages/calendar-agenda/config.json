{
  "tokens": {
    "textMuted": { "light": "#6e6e73", "dark": "#a1a1a6" },
    "surfaceRaised": { "light": "#ffffff", "dark": "#323438" }
  },
  "providers": {
    "calendar-agenda": { "type": "calendar", "lookahead": "@setting.lookahead", "soon": "@setting.soon", "now": "@setting.now" }
  },
  "popups": {
    "calendar-agenda": {
      "style": { "width": 300, "spacing": 8 },
      "layout": {
        "type": "column",
        "children": [
          {
            "type": "row",
            "children": [
              { "type": "field", "field": "text" },
              { "type": "symbol", "name": "video", "openField": "link", "hideWhenEmpty": "link", "alignment": "trailing" }
            ]
          },
          { "type": "divider" },
          {
            "type": "list", "source": "today",
            "row": {
              "type": "row", "openField": "link",
              "children": [
                { "type": "field", "field": "start", "style": { "width": 56, "foreground": "@token.textMuted" } },
                { "type": "field", "field": "title" }
              ]
            }
          },
          { "type": "divider" },
          {
            "type": "text", "text": "Calendar access", "open": "x-apple.systempreferences:com.apple.preference.security?Privacy_Calendars",
            "style": { "paddingHorizontal": 6, "paddingVertical": 4, "cornerRadius": 6, "hoverBackground": "@token.surfaceRaised" }
          }
        ]
      }
    }
  },
  "widgets": [
    {
      "id": "calendar-agenda", "type": "provider", "provider": "calendar-agenda", "position": "right", "popupName": "calendar-agenda",
      "layout": {
        "type": "row", "style": { "spacing": 6 },
        "children": [
          { "type": "field", "field": "text" },
          { "type": "field", "field": "minutes", "hideWhenEmpty": "minutes" },
          { "type": "text", "text": "min", "hideWhenEmpty": "minutes" }
        ]
      }
    }
  ]
}
