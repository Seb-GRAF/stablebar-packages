{
  "tokens": {
    "textMuted": { "light": "#5f6773", "dark": "#9aa3b0" }
  },
  "widgets": [
    {
      "id": "dock-badges",
      "type": "script",
      "position": "right",
      "command": "\"$PACKAGE_DIR/scripts/badges.sh\"",
      "interval": 10,
      "icon": "app.badge",
      "environment": { "APPS": "@setting.apps" },
      "layout": {
        "type": "list",
        "source": "apps",
        "orientation": "horizontal",
        "style": { "spacing": 12 },
        "row": {
          "type": "row",
          "style": { "spacing": 4 },
          "children": [
            { "type": "image", "source": "path", "style": { "width": 18, "height": 18 } },
            { "type": "field", "field": "badge" }
          ]
        }
      },
      "popup": {
        "style": { "width": 280, "paddingHorizontal": 18, "paddingVertical": 16, "spacing": 10 },
        "layout": {
          "type": "column",
          "children": [
            {
              "type": "row",
              "style": { "fontWeight": "bold", "fontSize": 15 },
              "children": [
                { "type": "text", "text": "Dock badges" },
                { "type": "field", "field": "total", "alignment": "trailing", "style": { "width": 50 } }
              ]
            },
            { "type": "field", "field": "hint", "hideWhenEmpty": "hint", "style": { "foreground": "@token.textMuted" } },
            {
              "type": "list",
              "source": "apps",
              "row": {
                "type": "row",
                "openField": "bundle",
                "children": [
                  { "type": "field", "field": "app" },
                  { "type": "field", "field": "badge", "alignment": "trailing", "style": { "width": 50, "foreground": "@token.textMuted" } }
                ]
              }
            }
          ]
        }
      }
    }
  ]
}
