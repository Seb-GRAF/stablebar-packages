{
  "tokens": {
    "surface": { "light": "#fbf1c7ee", "dark": "#282828ee" },
    "surfaceRaised": { "light": "#ebdbb2", "dark": "#3c3836" },
    "text": { "light": "#3c3836", "dark": "#ebdbb2" },
    "textMuted": { "light": "#7c6f64", "dark": "#a89984" },
    "accent": { "light": "#076678", "dark": "#83a598" },
    "track": { "light": "#3c383626", "dark": "#ebdbb226" },
    "hairline": { "light": "#3c383633", "dark": "#ebdbb233" },
    "warning": { "light": "#b57614", "dark": "#fabd2f" },
    "critical": { "light": "#9d0006", "dark": "#fb4934" }
  },
  "defaults": {
    "foreground": "@token.text",
    "background": "@token.surface",
    "hoverBackground": "@token.surfaceRaised",
    "borderColor": "@token.hairline",
    "accent": "@token.accent",
    "accentText": { "light": "#ffffff", "dark": "#282828" },
    "cornerRadius": 6
  }
}
