{
  "tokens": {
    "surface": { "light": "#eceff4ee", "dark": "#2e3440ee" },
    "surfaceRaised": { "light": "#e5e9f0", "dark": "#3b4252" },
    "text": { "light": "#2e3440", "dark": "#eceff4" },
    "textMuted": { "light": "#4c566a", "dark": "#d8dee9" },
    "accent": { "light": "#5e81ac", "dark": "#88c0d0" },
    "track": { "light": "#2e344026", "dark": "#eceff426" },
    "hairline": { "light": "#2e344033", "dark": "#eceff433" },
    "warning": { "light": "#bb5c3d", "dark": "#ebcb8b" },
    "critical": { "light": "#bf616a", "dark": "#c8777f" }
  },
  "defaults": {
    "foreground": "@token.text",
    "background": "@token.surface",
    "hoverBackground": "@token.surfaceRaised",
    "borderColor": "@token.hairline",
    "accent": "@token.accent",
    "accentText": { "light": "#ffffff", "dark": "#2e3440" },
    "cornerRadius": 6
  }
}
