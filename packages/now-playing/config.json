{
  "tokens": {
    "text": { "light": "#1f2329", "dark": "#e6e9ef" },
    "textMuted": { "light": "#5f6773", "dark": "#9aa3b0" },
    "surface": { "light": "#f4f5f7ed", "dark": "#23272eee" },
    "surfaceRaised": { "light": "#ffffff", "dark": "#323842" },
    "track": { "light": "#1f232926", "dark": "#e6e9ef26" }
  },
  "widgets": [
    {
      "id": "now-playing",
      "type": "nowPlaying",
      "position": "left",
      "transition": "fade",
      "template": "@setting.barLook",
      "popup": {
        "dismissOnAction": false,
        "style": { "width": 330, "paddingHorizontal": 18, "paddingVertical": 16, "spacing": 14 },
        "layout": {
          "type": "column",
          "children": [
            {
              "type": "row",
              "openField": "app",
              "style": { "spacing": 6, "foreground": "@token.textMuted" },
              "children": [
                { "type": "image", "source": "appIcon", "style": { "width": 16, "height": 16, "cornerRadius": 0 } },
                { "type": "field", "field": "source", "style": { "fontSize": 11, "fontWeight": "medium" } },
                { "type": "symbol", "name": "arrow.up.forward", "alignment": "trailing", "style": { "width": 16, "iconSize": 10 } }
              ]
            },
            {
              "type": "row",
              "style": { "spacing": 14 },
              "children": [
                {
                  "type": "image",
                  "source": "artwork",
                  "fit": "fill",
                  "openField": "app",
                  "style": { "width": 72, "height": 72, "cornerRadius": 6, "background": "@token.surfaceRaised" }
                },
                {
                  "type": "column",
                  "style": { "spacing": 3 },
                  "children": [
                    {
                      "type": "field",
                      "field": "title",
                      "scrollSpeed": 24,
                      "transition": "fade",
                      "style": { "width": 166, "fontSize": 14, "fontWeight": "semibold" }
                    },
                    { "type": "field", "field": "artist", "hideWhenEmpty": "artist", "transition": "fade", "style": { "fontSize": 12 } },
                    {
                      "type": "field",
                      "field": "album",
                      "hideWhenEmpty": "album",
                      "transition": "fade",
                      "style": { "fontSize": 12, "foreground": "@token.textMuted" }
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "hideWhenEmpty": "duration",
              "style": { "spacing": 5 },
              "children": [
                {
                  "type": "progress",
                  "source": "progress",
                  "height": 4,
                  "animation": { "duration": 1, "curve": "linear" },
                  "style": { "accent": "@token.text", "background": "@token.track", "cornerRadius": 2 }
                },
                {
                  "type": "row",
                  "style": { "fontSize": 10, "foreground": "@token.textMuted" },
                  "children": [
                    { "type": "field", "field": "elapsed" },
                    { "type": "field", "field": "duration", "alignment": "trailing" }
                  ]
                }
              ]
            },
            {
              "type": "row",
              "alignment": "center",
              "style": { "spacing": 8 },
              "children": [
                {
                  "type": "symbol",
                  "name": "gobackward.15",
                  "hideWhenEmpty": "canSeek",
                  "alignment": "center",
                  "nowPlayingCommand": "skipBackward",
                  "style": { "width": 28, "height": 28, "iconSize": 12, "cornerRadius": 8, "hoverBackground": "@token.surfaceRaised" }
                },
                {
                  "type": "symbol",
                  "name": "backward.fill",
                  "alignment": "center",
                  "hideWhenEmpty": "canPrevious",
                  "nowPlayingCommand": "previousTrack",
                  "style": { "width": 36, "height": 32, "iconSize": 15, "cornerRadius": 8, "hoverBackground": "@token.surfaceRaised" }
                },
                {
                  "type": "symbol",
                  "source": "control",
                  "alignment": "center",
                  "nowPlayingCommand": "togglePlayPause",
                  "style": {
                    "width": 42,
                    "height": 42,
                    "iconSize": 17,
                    "cornerRadius": 21,
                    "foreground": "@token.surface",
                    "background": "@token.text",
                    "states": { "hover": { "opacity": 0.8 } }
                  }
                },
                {
                  "type": "symbol",
                  "name": "forward.fill",
                  "alignment": "center",
                  "hideWhenEmpty": "canNext",
                  "nowPlayingCommand": "nextTrack",
                  "style": { "width": 36, "height": 32, "iconSize": 15, "cornerRadius": 8, "hoverBackground": "@token.surfaceRaised" }
                },
                {
                  "type": "symbol",
                  "name": "goforward.15",
                  "hideWhenEmpty": "canSeek",
                  "alignment": "center",
                  "nowPlayingCommand": "skipForward",
                  "style": { "width": 28, "height": 28, "iconSize": 12, "cornerRadius": 8, "hoverBackground": "@token.surfaceRaised" }
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "templates": {
    "Compact": {
      "layout": {
        "type": "row",
        "style": { "spacing": 6 },
        "children": [
          { "type": "image", "source": "artwork", "fit": "fill", "style": { "width": 16, "height": 16, "cornerRadius": 3 } },
          { "type": "field", "field": "line", "scrollSpeed": 20, "transition": "fade", "style": { "maxWidth": "@setting.barWidth" } },
          { "type": "equalizer", "source": "playing" }
        ]
      }
    },
    "Player": {
      "style": { "width": 284, "paddingHorizontal": 4 },
      "layout": {
        "type": "row",
        "style": { "spacing": 8 },
        "children": [
          { "type": "image", "source": "artwork", "fit": "fill", "style": { "width": 20, "height": 20, "cornerRadius": 10 } },
          {
            "type": "row",
            "alignment": "leading",
            "style": { "maxWidth": 182, "spacing": 0 },
            "children": [
              { "type": "field", "field": "title", "role": "primary", "transition": "fade" },
              { "type": "text", "text": " · ", "role": "secondary", "hideWhenEmpty": "artist" },
              { "type": "field", "field": "artist", "role": "secondary", "transition": "fade", "hideWhenEmpty": "artist" }
            ]
          },
          { "type": "field", "field": "elapsed", "role": "secondary", "alignment": "trailing", "style": { "minWidth": 30, "fontSize": 12 } },
          {
            "type": "symbol",
            "source": "control",
            "role": "time",
            "alignment": "center",
            "nowPlayingCommand": "togglePlayPause",
            "style": { "width": 20, "height": 20, "cornerRadius": 10, "iconSize": 10, "paddingHorizontal": 0 }
          }
        ]
      },
      "overlay": {
        "type": "row",
        "hideWhenEmpty": "duration",
        "style": { "paddingLeading": 32, "paddingTrailing": 32, "paddingBottom": 3 },
        "children": [
          { "type": "progress", "source": "progress", "height": 2, "role": "meter", "animation": { "duration": 1, "curve": "linear" } }
        ]
      }
    }
  }
}
