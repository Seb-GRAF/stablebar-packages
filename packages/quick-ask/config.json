{
  "tokens": {
    "textMuted": {
      "light": "#5f6773",
      "dark": "#9aa3b0"
    },
    "pill": {
      "light": "#0000000d",
      "dark": "#ffffff12"
    },
    "pillHover": {
      "light": "#0000001f",
      "dark": "#ffffff26"
    },
    "composer": {
      "light": "#00000005",
      "dark": "#ffffff08"
    },
    "hairline": {
      "light": "#0000001f",
      "dark": "#ffffff1f"
    }
  },
  "widgets": [
    {
      "id": "quick-ask",
      "type": "script",
      "position": "right",
      "command": "\"$PACKAGE_DIR/scripts/status.sh\"",
      "interval": null,
      "events": [
        "quick-ask"
      ],
      "icon": "sparkles",
      "popup": {
        "pinnable": true,
        "dismissOnAction": false,
        "animation": {
          "curve": "snappy",
          "duration": 0.35
        },
        "style": {
          "width": 440,
          "paddingHorizontal": 14,
          "paddingVertical": 12,
          "spacing": 10
        },
        "layout": {
          "type": "column",
          "children": [
            {
              "type": "column",
              "hideWhenEmpty": "chat",
              "style": {
                "spacing": 10
              },
              "children": [
                {
                  "type": "row",
                  "style": {
                    "spacing": 2,
                    "paddingTrailing": 52
                  },
                  "children": [
                    {
                      "type": "chooser",
                      "title": "Agent, model and effort",
                      "source": "agent",
                      "groupsSource": "agents",
                      "optionsSource": "models",
                      "levelsSource": "efforts",
                      "onChange": "\"$PACKAGE_DIR/scripts/ask.sh\" choose",
                      "starsSource": "stars",
                      "onStar": "\"$PACKAGE_DIR/scripts/ask.sh\" star"
                    },
                    {
                      "type": "symbol",
                      "name": "clock",
                      "onClick": "\"$PACKAGE_DIR/scripts/ask.sh\" view history",
                      "alignment": "center",
                      "style": {
                        "width": 26,
                        "height": 26,
                        "cornerRadius": 7,
                        "iconSize": 13,
                        "foreground": "@token.textMuted",
                        "hoverBackground": "@token.pill"
                      }
                    },
                    {
                      "type": "symbol",
                      "name": "square.and.pencil",
                      "onClick": "\"$PACKAGE_DIR/scripts/ask.sh\" new",
                      "alignment": "center",
                      "style": {
                        "width": 26,
                        "height": 26,
                        "cornerRadius": 7,
                        "iconSize": 13,
                        "foreground": "@token.textMuted",
                        "hoverBackground": "@token.pill"
                      },
                      "hideWhenEmpty": "conversation"
                    }
                  ]
                },
                {
                  "type": "list",
                  "source": "turns",
                  "maxHeight": 380,
                  "hideWhenEmpty": "conversation",
                  "style": {
                    "spacing": 14
                  },
                  "row": {
                    "type": "column",
                    "style": {
                      "spacing": 8
                    },
                    "children": [
                      {
                        "type": "field",
                        "field": "question",
                        "wrap": true,
                        "fitWidth": true,
                        "alignment": "trailing",
                        "style": {
                          "maxWidth": 320,
                          "background": "@token.pill",
                          "cornerRadius": 17,
                          "paddingHorizontal": 12,
                          "paddingVertical": 7
                        }
                      },
                      {
                        "type": "field",
                        "field": "status",
                        "shimmer": true,
                        "hideWhenEmpty": "status",
                        "style": {
                          "foreground": "@token.textMuted",
                          "fontWeight": "medium"
                        }
                      },
                      {
                        "type": "field",
                        "field": "thoughts",
                        "wrap": true,
                        "maxHeight": 72,
                        "hideWhenEmpty": "thoughts",
                        "style": {
                          "foreground": "@token.textMuted",
                          "fontSize": 11.5
                        }
                      },
                      {
                        "type": "field",
                        "field": "answer",
                        "wrap": true,
                        "markdown": true,
                        "hideWhenEmpty": "answer"
                      },
                      {
                        "type": "field",
                        "field": "note",
                        "wrap": true,
                        "hideWhenEmpty": "note",
                        "style": {
                          "foreground": "@token.textMuted"
                        }
                      },
                      {
                        "type": "row",
                        "hideWhenEmpty": "actions",
                        "style": {
                          "spacing": 2
                        },
                        "children": [
                          {
                            "type": "symbol",
                            "name": "doc.on.doc",
                            "onClickField": "copy",
                            "alignment": "center",
                            "style": {
                              "width": 24,
                              "height": 24,
                              "cornerRadius": 6,
                              "iconSize": 12,
                              "foreground": "@token.textMuted",
                              "hoverBackground": "@token.pill"
                            },
                            "hideWhenEmpty": "copy"
                          },
                          {
                            "type": "symbol",
                            "name": "arrow.clockwise",
                            "onClickField": "retry",
                            "alignment": "center",
                            "style": {
                              "width": 24,
                              "height": 24,
                              "cornerRadius": 6,
                              "iconSize": 12,
                              "foreground": "@token.textMuted",
                              "hoverBackground": "@token.pill"
                            },
                            "hideWhenEmpty": "retry"
                          }
                        ]
                      }
                    ]
                  }
                },
                {
                  "type": "input",
                  "title": "Question",
                  "placeholder": "Ask anything",
                  "autofocus": true,
                  "wrap": true,
                  "sendButton": true,
                  "busy": "running",
                  "onStop": "\"$PACKAGE_DIR/scripts/ask.sh\" stop",
                  "onSubmit": "\"$PACKAGE_DIR/scripts/ask.sh\" question",
                  "style": {
                    "background": "@token.composer",
                    "borderColor": "@token.hairline",
                    "borderWidth": 1,
                    "cornerRadius": 14,
                    "paddingLeading": 14,
                    "paddingTrailing": 6,
                    "paddingVertical": 6
                  }
                }
              ]
            },
            {
              "type": "column",
              "hideWhenEmpty": "history",
              "style": {
                "spacing": 8
              },
              "children": [
                {
                  "type": "row",
                  "style": {
                    "spacing": 6,
                    "paddingTrailing": 52
                  },
                  "children": [
                    {
                      "type": "symbol",
                      "name": "chevron.left",
                      "onClick": "\"$PACKAGE_DIR/scripts/ask.sh\" view chat",
                      "alignment": "center",
                      "style": {
                        "width": 26,
                        "height": 26,
                        "cornerRadius": 7,
                        "iconSize": 13,
                        "foreground": "@token.textMuted",
                        "hoverBackground": "@token.pill"
                      }
                    },
                    {
                      "type": "text",
                      "text": "History",
                      "style": {
                        "fontWeight": "semibold"
                      }
                    },
                    {
                      "type": "text",
                      "text": "Clear all",
                      "onClick": "\"$PACKAGE_DIR/scripts/ask.sh\" clear",
                      "hideWhenEmpty": "hasHistory",
                      "alignment": "center",
                      "style": {
                        "width": 72,
                        "height": 26,
                        "cornerRadius": 7,
                        "foreground": "@token.textMuted",
                        "hoverBackground": "@token.pill"
                      }
                    }
                  ]
                },
                {
                  "type": "field",
                  "field": "noHistory",
                  "wrap": true,
                  "hideWhenEmpty": "noHistory",
                  "style": {
                    "foreground": "@token.textMuted"
                  }
                },
                {
                  "type": "list",
                  "source": "history",
                  "row": {
                    "type": "row",
                    "style": {
                      "spacing": 4,
                      "paddingHorizontal": 8,
                      "paddingVertical": 6,
                      "cornerRadius": 8,
                      "hoverBackground": "@token.pill"
                    },
                    "children": [
                      {
                        "type": "column",
                        "onClickField": "open",
                        "style": {
                          "spacing": 2
                        },
                        "children": [
                          {
                            "type": "field",
                            "field": "title",
                            "style": {
                              "fontWeight": "semibold"
                            }
                          },
                          {
                            "type": "field",
                            "field": "detail",
                            "style": {
                              "foreground": "@token.textMuted",
                              "fontSize": 11
                            }
                          }
                        ]
                      },
                      {
                        "type": "symbol",
                        "name": "arrow.clockwise",
                        "onClickField": "replay",
                        "alignment": "center",
                        "style": {
                          "width": 26,
                          "height": 26,
                          "cornerRadius": 6,
                          "iconSize": 11,
                          "hoverBackground": "@token.pillHover"
                        }
                      },
                      {
                        "type": "symbol",
                        "name": "trash",
                        "onClickField": "delete",
                        "alignment": "center",
                        "style": {
                          "width": 26,
                          "height": 26,
                          "cornerRadius": 6,
                          "iconSize": 11,
                          "hoverBackground": "@token.pillHover"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "onOpen": "\"$PACKAGE_DIR/scripts/ask.sh\" opened",
        "onClose": "\"$PACKAGE_DIR/scripts/ask.sh\" closed"
      },
      "environment": {
        "NEW_CHAT_AFTER": "@setting.newChatAfter"
      }
    }
  ]
}
