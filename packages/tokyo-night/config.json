{
  "tokens": {
    "surface": { "light": "#e1e2e7ee", "dark": "#1a1b26ee" },
    "surfaceRaised": { "light": "#d0d5e3", "dark": "#292e42" },
    "text": { "light": "#3760bf", "dark": "#c0caf5" },
    "textMuted": { "light": "#6172b0", "dark": "#a9b1d6" },
    "accent": { "light": "#2e7de9", "dark": "#7aa2f7" },
    "track": { "light": "#3760bf26", "dark": "#c0caf526" },
    "hairline": { "light": "#3760bf33", "dark": "#c0caf533" },
    "warning": { "light": "#b15c00", "dark": "#e0af68" },
    "critical": { "light": "#c64343", "dark": "#f7768e" }
  },
  "defaults": {
    "foreground": "@token.text",
    "background": "@token.surface",
    "hoverBackground": "@token.surfaceRaised",
    "borderColor": "@token.hairline",
    "accent": "@token.accent",
    "accentText": { "light": "#ffffff", "dark": "#1a1b26" },
    "cornerRadius": 8
  }
}
